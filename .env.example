# Copy to .env and adjust as needed:  cp .env.example .env
# Loaded automatically by: make dhrishti

# --- Redis (local server; must support TimeSeries: TS.ADD / TS.RANGE) ---
DHRISHTI_REDIS_URL=redis://localhost:6379

# --- Go history writer ---
DHRISHTI_HISTORY_ENABLED=true
DHRISHTI_HISTORY_INTERVAL=10s
DHRISHTI_HISTORY_RETENTION=24h

# --- FastAPI history API ---
DHRISHTI_HISTORY_API_PORT=8000
DHRISHTI_HISTORY_RETENTION_HOURS=24

# --- Go engine config (optional) ---
# DHRISHTI_CONFIG=dhrishti.json
# DHRISHTI_ENTRY_SERVICES=api-gateway

# --- Benchmarks / simulation (optional) ---
# DHRISHTI_URL=http://localhost:8090
